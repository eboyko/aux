# frozen_string_literal: true

module Ledger
  class Process < ApplicationRecord
    # @!attribute [rw] states
    #   @return [ActiveRecord::Associations::CollectionProxy<Ledger::State>]
    has_many :states, class_name: 'Ledger::State', dependent: :restrict_with_error

    # @!attribute [rw] transitions
    #   @return [ActiveRecord::Associations::CollectionProxy<Ledger::Transition>]
    has_many :transitions, class_name: 'Ledger::Transition', dependent: :restrict_with_error
  end
end
