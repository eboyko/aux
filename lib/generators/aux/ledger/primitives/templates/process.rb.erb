# frozen_string_literal: true

module Ledger
  class Process < ApplicationRecord
    # @!attribute [rw] states
    #   @return [ActiveRecord::Associations::CollectionProxy<State>]
    has_many :states, class_name: 'State', dependent: :restrict_with_error

    # @!attribute [rw] transitions
    #   @return [ActiveRecord::Associations::CollectionProxy<Transition>]
    has_many :transitions, class_name: 'Transition', dependent: :restrict_with_error
  end
end
