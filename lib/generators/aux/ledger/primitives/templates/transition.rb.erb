# frozen_string_literal: true

module Ledger
  class Transition < ApplicationRecord
    # @!attribute [rw] process
    #   @return [Ledger::Process]
    belongs_to :process, class_name: 'Ledger::Process'

    # @!attribute [rw] previous_state
    #   @return [Ledger::State, nil]
    belongs_to :previous_state, class_name: 'Ledger::State', optional: true

    # @!attribute [rw] following_state
    #   @return [Ledger::State]
    belongs_to :following_state, class_name: 'Ledger::State'

    # @return [String]
    def cipher
      "#{process.code}.#{code}"
    end
  end
end
